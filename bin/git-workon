#!/bin/bash

set -euo pipefail
IFS=$'\n\t'

BASE_BRANCH=""
MOVE_CHANGES=0
UPDATE_SHARED=0
DRY_RUN=0
BRANCH_NAME=""

usage() {
  echo "Usage: git workon [-h] [-b base-branch] [-m] [-u] [-n] <branch-name>"
  echo "  -b <branch>   Base branch for new branches (default: origin/HEAD)"
  echo "  -m            Move uncommitted changes to the new worktree"
  echo "  -u            Update existing worktree with files from shared/"
  echo "  -n            Dry-run mode (show commands without executing)"
  echo ""
  echo "Creates or switches to a git worktree for the specified branch."
  echo "Branch names must match pattern: <number>-<word>[-<word>] or be a main branch."
  echo "Automatically applies .worktree-skeleton/ to new worktrees."
  echo ""
  echo "Shared resources:"
  echo "  - Create a .worktree-skeleton/ directory in your repo root"
  echo "  - Add symlinks/files to the skeleton that should appear in new worktrees"
  echo "  - The skeleton is overlaid on new worktrees (won't overwrite existing files)"
  exit 1
}

check_git_installed() {
  if ! command -v git &> /dev/null; then
    echo "Error: git is not installed." >&2
    exit 1
  fi
}

run_command() {
  if [ $DRY_RUN -eq 1 ]; then
    echo "[DRY-RUN] $*" >&2
  else
    "$@"
  fi
}

parse_arguments() {
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) usage ;;
      -b) BASE_BRANCH="$2"; shift ;;
      -m) MOVE_CHANGES=1 ;;
      -u) UPDATE_SHARED=1 ;;
      -n) DRY_RUN=1 ;;
      *) BRANCH_NAME="$1" ;;
    esac
    shift
  done

  if [ -z "${BRANCH_NAME:-}" ]; then
    usage
  fi
}

validate_branch_name() {
  # Allow main branch names (staging, main, master, develop) or pattern
  local main_branches="^(staging|main|master|develop|production)$"
  if [[ $BRANCH_NAME =~ $main_branches || $BRANCH_NAME =~ ^[0-9]+(-[a-zA-Z0-9]+)+$ ]]; then
    return 0
  else
    echo "Error: Branch name must match pattern: <number>-<word>[-<word>] or be a main branch name" >&2
    exit 1
  fi
}

get_repo_root() {
  # Get the main worktree path (where .git directory lives)
  local git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null || echo "")
  
  if [ -z "$git_common_dir" ]; then
    # Fallback for older git versions
    git_common_dir=$(git rev-parse --git-dir 2>/dev/null)
  fi
  
  # If we're in a worktree, git-common-dir points to the main .git
  # If we're in the main repo, it points to .git
  if [[ "$git_common_dir" == *"/.git" ]]; then
    dirname "$git_common_dir"
  elif [[ "$git_common_dir" == ".git" ]]; then
    # We're in the main repo directory with a bare setup
    pwd
  else
    # Handle other bare repository cases
    dirname "$git_common_dir"
  fi
}

is_bare_repo() {
  local repo_root=$(get_repo_root)
  [ -d "$repo_root/.git" ] && [ ! -d "$repo_root/.git/worktrees" ]
}

get_current_location() {
  # Determine if we're in the main repo or a worktree
  if [ -f ".git" ]; then
    echo "worktree"
  elif [ -d ".git" ]; then
    # Could be main repo or bare repo
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "main"
    else
      echo "bare"
    fi
  else
    echo "unknown"
  fi
}

stash_changes() {
  if [ $MOVE_CHANGES -eq 1 ] && [ -n "$(git status --porcelain 2>/dev/null || echo "")" ]; then
    local current_branch=$(git branch --show-current)
    echo "Stashing changes from $current_branch..." >&2
    run_command git stash push -u -m "workon_${current_branch}_to_${BRANCH_NAME}"
    return 0
  fi
  return 1
}

pop_stash() {
  if [ $MOVE_CHANGES -eq 1 ]; then
    local stash_index=$(git stash list | grep "workon_.*_to_${BRANCH_NAME}" | head -1 | cut -d: -f1)
    if [ -n "$stash_index" ]; then
      echo "Applying stashed changes to $BRANCH_NAME..." >&2
      run_command git stash pop "$stash_index"
    fi
  fi
}


create_shared_symlinks() {
  local worktree_path="$1"
  local repo_root=$(get_repo_root)
  local skeleton_dir="$repo_root/.worktree-skeleton"
  
  # If no skeleton exists, nothing to do
  if [ ! -d "$skeleton_dir" ] || [ -z "$(ls -A "$skeleton_dir" 2>/dev/null)" ]; then
    return 0
  fi
  
  echo "Applying shared resource symlinks..." >&2
  
  # Use rsync to copy skeleton to worktree
  # --ignore-existing: don't overwrite existing files
  # -a: archive mode (preserves symlinks)
  # -v: verbose (show what's being copied)
  if [ $DRY_RUN -eq 1 ]; then
    echo "[DRY-RUN] rsync -av --ignore-existing $skeleton_dir/ $worktree_path/" >&2
    # Show what would be copied
    rsync -av --ignore-existing --dry-run "$skeleton_dir/" "$worktree_path/" | grep -v "^$" | sed 's/^/[DRY-RUN] /' >&2
  else
    rsync -av --ignore-existing "$skeleton_dir/" "$worktree_path/" | grep -v "^$" >&2
  fi
}


calculate_relative_path() {
  local target="$1"
  local source="$2"
  
  # Get the directory containing the target
  local target_dir=$(dirname "$target")
  
  # Use Python for reliable relative path calculation if available
  if command -v python3 &> /dev/null; then
    python3 -c "import os; print(os.path.relpath('$source', '$target_dir'))"
  elif command -v python &> /dev/null; then
    python -c "import os; print(os.path.relpath('$source', '$target_dir'))"
  else
    # Fallback: simple relative path calculation
    # This works for the common case where shared is ../shared from the worktree
    local depth=$(echo "$target_dir" | tr -cd '/' | wc -c)
    local prefix=""
    for ((i=0; i<depth; i++)); do
      prefix="../$prefix"
    done
    echo "${prefix}shared/$(basename "$source")"
  fi
}

fix_remote_tracking() {
  local branch_name="$1"
  local worktree_path="$2"
  
  if [ $DRY_RUN -eq 1 ]; then
    echo "[DRY-RUN] cd $worktree_path && git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'" >&2
    echo "[DRY-RUN] cd $worktree_path && git fetch origin" >&2
    echo "[DRY-RUN] cd $worktree_path && git branch --set-upstream-to=origin/$branch_name $branch_name" >&2
  else
    # Configure the fetch refspec for the worktree
    # This is necessary because worktrees from bare repos don't have this configured
    (cd "$worktree_path" && git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*')
    
    # Fetch all remote branches
    (cd "$worktree_path" && git fetch origin >/dev/null 2>&1)
    
    # Now set up tracking
    (cd "$worktree_path" && git branch --set-upstream-to="origin/$branch_name" "$branch_name" 2>/dev/null) || true
  fi
}

create_or_switch_worktree() {
  local repo_root=$(get_repo_root)
  local location=$(get_current_location)
  local worktree_path=""
  
  # Determine the worktree path based on where we are
  if [ "$location" = "worktree" ]; then
    # We're in a worktree, use ../ prefix
    worktree_path="../$BRANCH_NAME"
  else
    # We're in the main/bare repo
    worktree_path="$BRANCH_NAME"
  fi
  
  # Get absolute path for checking if worktree exists
  local abs_worktree_path="$repo_root/$BRANCH_NAME"
  
  # Check if worktree already exists
  # git worktree list output format: <path> <commit> [<branch>]
  local worktree_exists=0
  while IFS= read -r line; do
    local worktree_path=$(echo "$line" | awk '{print $1}')
    if [ "$worktree_path" = "$abs_worktree_path" ]; then
      worktree_exists=1
      break
    fi
  done < <(git worktree list)
  
  if [ $worktree_exists -eq 1 ]; then
    # Worktree already exists
    if [ $UPDATE_SHARED -eq 1 ]; then
      echo "Updating existing worktree symlinks from shared/..." >&2
      create_shared_symlinks "$abs_worktree_path"
    fi
    echo "$abs_worktree_path"
    return 0
  fi
  
  # Set default base branch if not specified
  if [ -z "$BASE_BRANCH" ]; then
    BASE_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|^refs/remotes/||' || echo "origin/main")
  fi
  
  # Check if local branch exists
  if git show-ref --quiet refs/heads/$BRANCH_NAME; then
    echo "Creating worktree for existing branch $BRANCH_NAME..." >&2
    run_command git worktree add "$abs_worktree_path" "$BRANCH_NAME"
    fix_remote_tracking "$BRANCH_NAME" "$abs_worktree_path"
  else
    # Check if remote branch exists
    if [ $DRY_RUN -eq 1 ]; then
      run_command git fetch origin
    else
      git fetch origin >/dev/null 2>&1
    fi
    if git show-ref --quiet refs/remotes/origin/$BRANCH_NAME; then
      echo "Creating worktree for remote branch $BRANCH_NAME..." >&2
      run_command git worktree add "$abs_worktree_path" "$BRANCH_NAME"
      fix_remote_tracking "$BRANCH_NAME" "$abs_worktree_path"
    else
      # Create new branch
      echo "Creating new branch $BRANCH_NAME from $BASE_BRANCH..." >&2
      run_command git worktree add -b "$BRANCH_NAME" "$abs_worktree_path" "$BASE_BRANCH"
      
      # Push to remote and set upstream
      if [ $DRY_RUN -eq 1 ]; then
        echo "[DRY-RUN] cd $abs_worktree_path && git push --set-upstream origin $BRANCH_NAME" >&2
        echo "[DRY-RUN] cd $abs_worktree_path && git fetch origin $BRANCH_NAME:refs/remotes/origin/$BRANCH_NAME" >&2
        echo "[DRY-RUN] cd $abs_worktree_path && git branch --set-upstream-to=origin/$BRANCH_NAME $BRANCH_NAME" >&2
      else
        (cd "$abs_worktree_path" && git push --set-upstream origin "$BRANCH_NAME")
        # Even after push --set-upstream, we need to ensure the remote-tracking ref exists
        fix_remote_tracking "$BRANCH_NAME" "$abs_worktree_path"
      fi
    fi
  fi
  
  # Create symlinks to shared resources
  create_shared_symlinks "$abs_worktree_path"
  
  echo "$abs_worktree_path"
}

main() {
  check_git_installed
  parse_arguments "$@"
  validate_branch_name
  
  # Ensure we're in a git repository
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Error: Not in a git repository" >&2
    exit 1
  fi
  
  # Save current branch for stashing (if we're in a worktree)
  local original_branch=""
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    original_branch=$(git branch --show-current)
  fi
  
  local stashed=0
  
  # Stash changes if requested and we're in a working tree
  if [ -n "$original_branch" ] && stash_changes; then
    stashed=1
  fi
  
  # Create or switch to worktree
  local worktree_path=$(create_or_switch_worktree)
  
  # Pop stash in new worktree if we stashed
  if [ $stashed -eq 1 ]; then
    (cd "$worktree_path" && pop_stash)
  fi
  
  # Output the path for cd
  echo "$worktree_path"
}

main "$@"